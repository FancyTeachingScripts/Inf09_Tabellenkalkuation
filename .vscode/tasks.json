{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "compile-single-tex",
            "type": "shell",
            "command": "tectonic",
            "args": [
                "-Z", "search-path=.",
                "-Z", "search-path=sty/moloch",
                "-Z", "continue-on-errors",
                "-o", "build",
                "main.tex"
            ],
            "group": "build",
            "presentation": {
                "echo": true,
                "reveal": "always",
                "focus": false,
                "panel": "shared"
            },
            "problemMatcher": []
        },
        {
            "label": "build-all-main-tex",
            "type": "shell",
            "windows": {
                "command": "powershell",
                "args": [
                    "-ExecutionPolicy", "Bypass",
                    "-File", "${workspaceFolder}/.vscode/build-parallel.ps1"
                ]
            },
            "linux": {
                "command": "bash",
                "args": [
                    "${workspaceFolder}/.vscode/build-parallel.sh"
                ]
            },
            "osx": {
                "command": "bash",
                "args": [
                    "${workspaceFolder}/.vscode/build-parallel.sh"
                ]
            },
            "group": "build",
            "presentation": {
                "echo": true,
                "reveal": "always",
                "focus": false,
                "panel": "shared"
            },
            "problemMatcher": []
        }
    ]
}
